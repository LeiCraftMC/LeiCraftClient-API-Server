
LCC_LOG_LEVEL=info

LCC_API_HOST=::
LCC_API_PORT=12331
# Booleans: exactly "true" or "false" (case-sensitive); anything else — including an empty value — fails at startup.
# An unset variable falls back to the schema default.
LCC_API_DISABLE_DOCS=false

# Public origin of this API — used to build the absolute asset URLs (/assets/<sha256>.<png|json>)
LCC_API_PUBLIC_URL=http://localhost:12331
# Read the client IP from X-Forwarded-For (rate limits). Only behind a trusted reverse proxy.
LCC_API_TRUST_PROXY=false

LCC_DB_PATH=./data/db.sqlite
LCC_DB_AUTO_MIGRATE=true
LCC_DB_MIGRATION_DIR=./drizzle/migrations

LCC_LOG_DIR=./data/logs
LCC_CONFIG_BASE_DIR=./config

# Uploaded textures, models and images (content-addressed files)
LCC_ASSETS_DIR=./data/assets

# Website origin: CORS allowlist, Discord redirect and the Minecraft link URLs the mod opens
LCC_APP_URL=http://localhost:12332

# Discord application (https://discord.com/developers/applications) — the same app as LeiCraft Client V1.
# Add the redirect URI below to the app's OAuth2 redirects.
LCC_DISCORD_CLIENT_ID=
LCC_DISCORD_CLIENT_SECRET=
# Defaults to <LCC_APP_URL>/auth/discord/callback
# LCC_DISCORD_REDIRECT_URI=http://localhost:12332/auth/discord/callback
# Users are added to this server on login (scope guilds.join) when both are set; the bot must be in the server.
# LCC_DISCORD_GUILD_ID=
# LCC_DISCORD_BOT_TOKEN=

# Discord user IDs that become admins when they log in (comma-separated) — bootstraps the first admin.
LCC_ADMIN_DISCORD_IDS=

# LCC_MOJANG_SESSION_SERVER_URL=https://sessionserver.mojang.com

# ─── Mod releases ────────────────────────────────────────────────────────────────────────────
# Where the Fabric mod's releases are built: the API creates the GitLab release (tag + pipeline
# that uploads the jar to the package registry) when an admin publishes one on the dashboard,
# and watches it until the jar asset link appears.

# LCC_GITLAB_API_BASE_URL=https://git.leicraftmc.de/api/v4
# LCC_GITLAB_PROJECT_ID=79
# Branch new release tags (v<version>) are created from
# LCC_GITLAB_RELEASE_REF=main
# Fine-grained personal access token (https://git.leicraftmc.de/-/user_settings/personal_access_tokens):
# create it with the minimum permissions the integration needs, limited to the Fabric project —
# "Release" (read/write), "Repository" (read, for gradle.properties of the tag) and "Pipeline"
# (read, to notice a failed build). Creating a release pushes the v<version> tag, so the token's
# user must be allowed to create that tag (Maintainer if v* tags are protected). Without
# fine-grained tokens use a project access token with the `api` scope. Server-side only.
LCC_GITLAB_TOKEN=

# Auto-publish of finished releases to Modrinth (the "Auto-publish to Modrinth" checkbox on the
# dashboard; on by default). Token is created on the Modrinth project's page and is limited to
# that project. Empty values disable the feature and make publish requests that want Modrinth fail.
LCC_MODRINTH_PROJECT_ID=
LCC_MODRINTH_TOKEN=
# LCC_MODRINTH_URL=https://api.modrinth.com/v2
